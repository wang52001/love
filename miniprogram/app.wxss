.gap-12 > view + view { margin-left: 12rpx; margin-top: 12rpx; }
.gap-16 > view + view { margin-left: 16rpx; margin-top: 16rpx; }
.gap-20 > view + view { margin-left: 20rpx; margin-top: 20rpx; }
.gap-24 > view + view { margin-left: 24rpx; margin-top: 24rpx; }
.gap-32 > view + view { margin-left: 32rpx; margin-top: 32rpx; }
.flex-1 { flex: 1; }
.w-full { width: 100%; }
.h-full { height: 100%; }
.text-left { text-align: left; }
.text-center { text-align: center; }
.text-right { text-align: right; }

.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-state .empty-emoji {
  font-size: 96rpx;
  margin-bottom: 20rpx;
  display: block;
}

.empty-state .empty-text {
  color: #A094AC;
  font-size: 26rpx;
}

@keyframes float {
  0%, 100% { transform: translateY(0rpx); }
  50% { transform: translateY(-10rpx); }
}

@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

@keyframes slowSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.animate-float {
  animation: float 3s ease-in-out infinite;
}

.animate-float-slow {
  animation: float 6s ease-in-out infinite;
}

.animate-breathe {
  animation: breathe 4s ease-in-out infinite;
}

.animate-slow-spin {
  animation: slowSpin 30s linear infinite;
}
