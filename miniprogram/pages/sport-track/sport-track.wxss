.track-page {
  padding-bottom: 40rpx;
}
.track-top {
  text-align: center;
  padding-top: 24rpx;
}
.track-type {
  font-size: 28rpx;
  color: #7A6B95;
  background: rgba(168, 230, 207, 0.2);
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}
.track-timer {
  font-size: 96rpx;
  font-weight: 200;
  color: #2B2438;
  font-variant-numeric: tabular-nums;
  margin-top: 16rpx;
  letter-spacing: 4rpx;
}
.track-status {
  font-size: 24rpx;
  color: #A094AC;
  margin-top: 8rpx;
}
.track-status.tracking {
  color: #A8E6CF;
}
.track-status.tracking::before {
  content: '';
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #A8E6CF;
  margin-right: 10rpx;
  animation: pulse 1s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
.track-stats {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 32rpx;
  padding: 0 40rpx;
}
.stat-box {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #2B2438;
  line-height: 1.1;
}
.stat-unit {
  font-size: 22rpx;
  color: #A094AC;
  margin-top: 6rpx;
}
.stat-divider {
  width: 1rpx;
  height: 80rpx;
  background: #F0E8EA;
}
.map-wrap {
  margin: 32rpx 24rpx 0;
  padding: 12rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #FFFFFF;
  border: 1rpx solid #F0E8EA;
}
.sport-map {
  width: 100%;
  height: 480rpx;
  border-radius: 24rpx;
}
.map-hint {
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx 8rpx;
}
.hint-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFD93D;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.hint-text {
  font-size: 22rpx;
  color: #A094AC;
  line-height: 1.5;
}
.track-controls {
  margin: 40rpx 48rpx 0;
  display: flex;
  gap: 24rpx;
}
.btn-track {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  text-align: center;
}
.btn-warn {
  background: linear-gradient(135deg, #FFB3C6, #FF8FAB);
  color: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(255, 143, 171, 0.35);
}
.btn-warn:active {
  transform: scale(0.98);
}
.disabled {
  opacity: 0.6;
}
.track-tips {
  margin-top: 24rpx;
  text-align: center;
  padding: 0 48rpx;
  line-height: 1.5;
}
