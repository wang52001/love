.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 16rpx;
}
.month-nav {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #F0E8EA;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(184, 169, 255, 0.10);
}
.nav-arrow {
  font-size: 44rpx;
  font-weight: 300;
  color: #5D5168;
}
.month-title {
  text-align: center;
}
.stats-row {
  display: flex;
  align-items: stretch;
  margin-top: 24rpx;
  margin-bottom: 32rpx;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 4rpx;
}
.stat-emoji {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.1;
}
.sun-text { color: #FFD27A; }
.rain-text { color: #7393B3; }
.streak-text { color: #FF8FAB; }
.rainbow-text { color: #B8A9FF; }
.stat-label {
  font-size: 22rpx;
  color: #A094AC;
  margin-top: 6rpx;
}
.stat-divider {
  width: 1rpx;
  background: #F0E8EA;
  margin: 16rpx 0;
}
.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-top: 16rpx;
  padding: 0 8rpx;
}
.weekday {
  font-size: 24rpx;
  color: #A094AC;
  text-align: center;
  padding: 16rpx 0;
  font-weight: 500;
}
.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-top: 16rpx;
}
.cal-cell {
  padding: 6rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 10rpx;
  height: 120rpx;
}
.cal-cell.empty {
  visibility: hidden;
}
.cell-orb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.18s;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}
.cal-cell.selected .cell-orb {
  box-shadow: 0 10rpx 24rpx rgba(255, 143, 171, 0.25);
  transform: translateY(-2rpx);
}
.cal-cell.today .cell-orb {
  border: 2rpx solid #FF8FAB;
}
.cell-emoji {
  font-size: 32rpx;
  line-height: 1;
}
.cell-placeholder {
  font-size: 30rpx;
  line-height: 1;
  opacity: 0.55;
}
.cell-num {
  position: absolute;
  bottom: 4rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1;
}
.cell-num.placeholder-num {
  color: #A094AC;
  font-weight: 500;
}
.cell-today-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FF8FAB;
  margin-top: 20rpx;
  box-shadow: 0 0 8rpx rgba(255, 143, 171, 0.6);
}
.legend {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
  padding: 0 8rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
  margin-bottom: 16rpx;
}
.legend-orb {
  width: 40rpx;
  height: 40rpx;
  border-radius: 14rpx;
  margin-right: 12rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}
.legend-label {
  font-size: 22rpx;
  color: #5D5168;
  font-weight: 500;
}
.detail {
  margin-top: 32rpx;
}
.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.detail-date {
  font-size: 32rpx;
  font-weight: 700;
}
.detail-weather-name {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #FF8FAB;
}
.detail-emoji {
  font-size: 48rpx;
  line-height: 1;
}
.empty-emoji {
  opacity: 0.4;
}
.detail-split {
  height: 1rpx;
  background: #F0E8EA;
}
.detail-sides {
  margin-top: 20rpx;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
}
.side {
  flex: 1;
}
.side-label {
  font-size: 22rpx;
  color: #A094AC;
  margin-bottom: 8rpx;
}
.side-card {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background: #FFFBF8;
  border-radius: 24rpx;
  border: 1rpx solid #F0E8EA;
}
.side-card.right {
  flex-direction: row-reverse;
}
.side-orb {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.06);
  margin-right: 12rpx;
}
.side-card.right .side-orb {
  margin-right: 0;
  margin-left: 12rpx;
}
.side-info {
  flex: 1;
  min-width: 0;
}
.side-name {
  font-size: 26rpx;
  font-weight: 600;
}
.side-note {
  font-size: 22rpx;
  color: #A094AC;
  margin-top: 8rpx;
  line-height: 1.5;
}
.vs-line {
  width: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
}
.vs-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8FAB, #B8A9FF);
  box-shadow: 0 0 0 6rpx rgba(255, 143, 171, 0.08);
}
.detail-empty {
  margin-top: 8rpx;
}
.detail-rating {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  background: #FFFBF8;
  border-radius: 20rpx;
  border: 1rpx solid #F0E8EA;
}
.rating-label {
  font-size: 24rpx;
  color: #5D5168;
  font-weight: 500;
}
.rating-stars {
  font-size: 28rpx;
  margin: 0 8rpx;
  letter-spacing: 2rpx;
}

/* 真实天气条 */
.real-weather-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  gap: 16rpx;
}
.rw-bar-emoji {
  font-size: 48rpx;
}
.rw-bar-temp {
  font-size: 36rpx;
  font-weight: 700;
  color: #2B2438;
}
.rw-bar-desc {
  font-size: 22rpx;
  flex: 1;
  color: #8B7A88;
}
.go-report {
  margin-top: 40rpx;
  margin-bottom: 32rpx;
}
.mb-8 { margin-bottom: 8rpx; }
.mt-8 { margin-top: 8rpx; }
