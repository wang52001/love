.hero {
  margin-top: 48rpx;
  padding: 48rpx 40rpx;
  position: relative;
  min-height: 280rpx;
  overflow: hidden;
  color: #FFFFFF;
}
.hero.rainy-hero {
  background: linear-gradient(155deg, #53547A 0%, #7393B3 100%);
}
.hero.empty-hero {
  background: linear-gradient(155deg, #B8A9FF 0%, #FFB3C6 100%);
  color: #FFFFFF;
}
.hero-bg {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}
.hero-inner {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.hero-emoji {
  font-size: 120rpx;
}
.hero-badge {
  display: inline-block;
  margin-top: 16rpx;
}
.hero-title {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}
.hero-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
  max-width: 540rpx;
  font-weight: 500;
}
.stats {
  margin-top: 40rpx;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
}
.stat-card {
  flex: 1;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-right: 16rpx;
}
.stat-card:last-child {
  margin-right: 0;
}
.stat-num {
  font-size: 52rpx;
  font-weight: 900;
  color: #FF8FAB;
  line-height: 1.1;
}
.stat-label {
  font-size: 22rpx;
  color: #5D5168;
  margin-top: 8rpx;
  font-weight: 500;
}
.tips-wrap {
  margin-top: 40rpx;
}
.tips {
  padding: 32rpx;
}
.tip-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0E8EA;
}
.tip-item:last-child {
  border-bottom: none;
}
.tip-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #FFE8EE, #EEE9FF);
  color: #FF8FAB;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.tip-content {
  flex: 1;
  min-width: 0;
}
.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2438;
}
.tip-desc {
  font-size: 24rpx;
  color: #A094AC;
  margin-top: 8rpx;
  line-height: 1.6;
}
.list-wrap {
  display: flex;
  flex-direction: column;
}
.alert-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  transition: transform 0.18s;
}
.alert-row:active {
  transform: scale(0.985);
}
.row-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.al-orb {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  margin-right: 20rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #EEE9FF, #FFE8EE);
}
.al-orb.today {
  background: linear-gradient(135deg, #FF8FAB, #FFD27A);
}
.al-orb.urgent {
  background: linear-gradient(135deg, #FF8FAB, #FF6B6B);
}
.al-orb.soon {
  background: linear-gradient(135deg, #FFD27A, #FFE8A8);
}
.al-emoji {
  font-size: 40rpx;
}
.al-body {
  flex: 1;
  min-width: 0;
}
.al-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2B2438;
}
.al-meta {
  font-size: 22rpx;
  color: #A094AC;
  margin-top: 6rpx;
}
.al-note {
  font-size: 22rpx;
  color: #A094AC;
  margin-top: 8rpx;
  line-height: 1.5;
}
.row-right {
  flex-shrink: 0;
}
.al-days {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFFBF8, #FBF7FF);
  min-width: 88rpx;
}
.al-days.today {
  background: linear-gradient(135deg, #FFE8EE, #FFD6A5);
}
.al-days.urgent {
  background: linear-gradient(135deg, #FFE2E2, #FFE8EE);
}
.days-num {
  font-size: 40rpx;
  font-weight: 900;
  color: #FF8FAB;
  line-height: 1;
}
.days-unit {
  font-size: 20rpx;
  color: #A094AC;
  margin-top: 4rpx;
}
.cta-wrap {
  margin-top: 48rpx;
}
.form-panel {
  margin-top: 32rpx;
  padding: 32rpx;
}
.form-row {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 24rpx;
  color: #A094AC;
  margin-bottom: 10rpx;
}
.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 28rpx;
}
.mt-10 { margin-top: 10rpx; }
.mt-6 { margin-top: 6rpx; }
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-10 { margin-bottom: 10rpx; }
.al-type-empty {
  display: block;
}
