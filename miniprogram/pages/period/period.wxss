.container { padding: 0 32rpx 48rpx; background: #FFFBF8; min-height: 100vh; }
.page-header { padding-top: 48rpx; }
.page-title { font-size: 48rpx; font-weight: 800; color: #FF8FAB; letter-spacing: 2rpx; }
.page-sub { font-size: 26rpx; color: #7A6E8A; font-weight: 500; }
.period-hero-img { width: 100%; margin-top: 32rpx; border-radius: 32rpx; box-shadow: 0 16rpx 40rpx rgba(139,119,149,0.12); display: block; }

.muted-light { color: #B5ACC4; }
.row-center { align-items: center; }

.glass-card { background: rgba(255,255,255,0.85); border-radius: 32rpx; padding: 32rpx; box-shadow: 0 12rpx 40rpx rgba(139,119,149,0.10); backdrop-filter: blur(12rpx); border: 1rpx solid rgba(255,255,255,0.8); position: relative; overflow: hidden; }

/* ============ 性别选择 ============ */
.gender-card { position: relative; overflow: hidden; text-align: center; padding: 56rpx 32rpx; }
.gender-deco { position: absolute; border-radius: 50%; opacity: 0.35; }
.gender-deco.deco-a { width: 200rpx; height: 200rpx; background: #FFD6E4; top: -60rpx; right: -40rpx; }
.gender-deco.deco-b { width: 140rpx; height: 140rpx; background: #E8E0FF; bottom: -40rpx; left: -30rpx; }
.gender-emoji { font-size: 88rpx; position: relative; z-index: 1; }
.gender-title { color: #5D5168; position: relative; z-index: 1; }
.gender-desc { color: #7A6E8A; position: relative; z-index: 1; }
.gender-actions { display: flex; gap: 24rpx; position: relative; z-index: 1; }
.gender-pick { flex: 1; background: rgba(255,255,255,0.8); border-radius: 24rpx; padding: 32rpx 16rpx; border: 2rpx solid #F0E8EE; transition: all 0.2s; }
.gender-pick.on { border-color: #FF8FB1; background: #FFF5F8; }
.gender-pick:active { transform: scale(0.97); }
.gp-emoji { font-size: 64rpx; }
.gp-label { color: #5D5168; margin-top: 12rpx; }
.gp-sub { margin-top: 4rpx; }

/* ============ 当前阶段大卡 ============ */
.hero-card { position: relative; overflow: hidden; border-radius: 32rpx; padding: 40rpx 32rpx; box-shadow: 0 12rpx 40rpx rgba(139,119,149,0.12); }
.hero-deco { position: absolute; border-radius: 50%; opacity: 0.3; }
.hero-deco.deco-1 { width: 220rpx; height: 220rpx; background: rgba(255,255,255,0.6); top: -80rpx; right: -60rpx; }
.hero-deco.deco-2 { width: 120rpx; height: 120rpx; background: rgba(255,255,255,0.5); bottom: -30rpx; left: 20rpx; }
.hero-top { display: flex; align-items: center; position: relative; z-index: 1; }
.hero-emoji { font-size: 88rpx; margin-right: 24rpx; }
.hero-meta { flex: 1; }
.hero-phase { line-height: 1.2; }
.hero-sub { color: #7A6E8A; font-weight: 500; }
.hero-desc { color: #5D5168; line-height: 1.6; position: relative; z-index: 1; }
.hero-flags { display: flex; flex-wrap: wrap; gap: 16rpx; position: relative; z-index: 1; }
.flag-chip { padding: 10rpx 24rpx; border-radius: 999rpx; background: rgba(255,255,255,0.8); }
.flag-chip .flag-text { font-size: 22rpx; font-weight: 600; color: #FFFFFF; }
.flag-chip.flag-next .flag-text { color: #5D5168; }

/* ============ 空状态 ============ */
.empty-hero { text-align: center; padding: 56rpx 32rpx; }
.eh-emoji { font-size: 80rpx; }
.eh-title { color: #5D5168; margin-top: 16rpx; }
.eh-desc { color: #7A6E8A; line-height: 1.6; }
.empty-tip { color: #9A8EAA; }

/* ============ 通用卡片 ============ */
.card { position: relative; }
.card-head { display: flex; align-items: center; justify-content: space-between; }
.card-title { color: #5D5168; }
.card-tag { color: #7A6E8A; background: #F7F2F4; padding: 6rpx 18rpx; border-radius: 999rpx; font-weight: 500; }

/* ============ 时间轴 ============ */
.tl-bar { position: relative; display: flex; height: 56rpx; border-radius: 16rpx; overflow: visible; background: #F7F2F4; }
.tl-seg { height: 56rpx; display: flex; align-items: center; justify-content: center; position: relative; }
.tl-seg:first-child { border-radius: 16rpx 0 0 16rpx; }
.tl-seg:last-child { border-radius: 0 16rpx 16rpx 0; }
.tl-emoji { font-size: 28rpx; opacity: 0.9; }
.tl-pointer { position: absolute; top: 0; bottom: 0; width: 0; z-index: 2; transform: translateX(-50%); }
.tl-pointer-dot { position: absolute; top: 18rpx; left: 50%; transform: translateX(-50%); width: 20rpx; height: 20rpx; border-radius: 50%; background: #FFFFFF; border: 4rpx solid #5D5168; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15); }
.tl-pointer-line { position: absolute; top: 28rpx; bottom: -8rpx; left: 50%; width: 3rpx; background: #5D5168; opacity: 0.5; transform: translateX(-50%); }
.tl-legend { display: flex; flex-wrap: wrap; }
.tl-leg-item { width: 50%; box-sizing: border-box; display: flex; align-items: flex-start; padding: 12rpx 0; }
.tl-leg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 10rpx; margin-top: 8rpx; flex-shrink: 0; }
.tl-leg-body { flex: 1; min-width: 0; }
.tl-leg-row { display: flex; align-items: center; justify-content: space-between; }
.tl-leg-label { color: #5D5168; }
.tl-leg-days { color: #9A8EAA; margin-left: 8rpx; flex-shrink: 0; }
.tl-leg-date { color: #B5ACC4; font-size: 20rpx; margin-top: 4rpx; }
.tl-foot { color: #9A8EAA; line-height: 1.6; }

/* ============ 护理建议 ============ */
.tip-list { }
.tip-item { display: flex; align-items: flex-start; padding: 12rpx 0; }
.tip-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-top: 12rpx; margin-right: 16rpx; flex-shrink: 0; }
.tip-text { color: #5D5168; line-height: 1.6; flex: 1; }

/* ============ 快速记录 ============ */
.record-row { display: flex; gap: 20rpx; }
.record-hint { color: #9A8EAA; }

/* ============ AI 分析 ============ */
.refresh-btn { color: #FF8FB1; padding: 6rpx 16rpx; }
.ai-body { background: #FAF5F8; border-radius: 20rpx; padding: 24rpx; }
.ai-text { color: #5D5168; line-height: 1.7; white-space: pre-wrap; }
.ai-empty { text-align: center; padding: 16rpx 0; }

/* ============ 关怀列表（女生收到 / 男生已送） ============ */
.care-list { }
.care-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #F0E8EE; }
.care-item:last-child { border-bottom: none; }
.care-emoji { font-size: 48rpx; margin-right: 20rpx; flex-shrink: 0; }
.care-body { flex: 1; min-width: 0; }
.care-label { color: #5D5168; }
.care-msg { color: #7A6E8A; line-height: 1.5; }
.care-time { color: #B5ACC4; flex-shrink: 0; margin-left: 16rpx; }

/* ============ 关怀动作网格（男生发送） ============ */
.care-grid { display: flex; flex-wrap: wrap; }
.care-cell {
  width: 33.33%;
  box-sizing: border-box;
  padding: 8rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(139,119,149,0.08);
  transition: transform 0.2s;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
}
.care-cell:active { transform: scale(0.96); }
.cc-emoji { font-size: 56rpx; margin-bottom: 12rpx; }
.cc-label { color: #5D5168; font-weight: 600; font-size: 24rpx; }
.care-cell.sending { background: #F7F2F4; opacity: 0.7; }
.cc-sending { color: #A79BB0; margin-top: 8rpx; font-size: 20rpx; }

/* ============ 周期设置表单 ============ */
.form-row { display: flex; align-items: center; }
.form-label { color: #5D5168; flex-shrink: 0; }
.form-input {
  flex: 1;
  margin: 0 16rpx;
  padding: 18rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #2B2438;
  border: 2rpx solid #F0E8EE;
  box-shadow: 0 4rpx 12rpx rgba(139,119,149,0.04);
}
.unit { color: #9A8EAA; }
.form-hint { color: #9A8EAA; }

/* ============ 历史记录 ============ */
.rec-list { }
.rec-item { display: flex; align-items: flex-start; padding: 16rpx 0; border-bottom: 1rpx solid #F0E8EE; }
.rec-item:last-child { border-bottom: none; }
.rec-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #FF8FB1; margin-top: 12rpx; margin-right: 16rpx; flex-shrink: 0; }
.rec-body { flex: 1; min-width: 0; }
.rec-date { color: #5D5168; }
.rec-note { color: #9A8EAA; }

/* ============ 底部安全区 ============ */
.safe-bottom { height: 48rpx; }
