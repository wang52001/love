.container { padding: 0 32rpx 48rpx; background: #FFFBF8; min-height: 100vh; }
.page-header { padding-top: 48rpx; }
.page-title { font-size: 48rpx; font-weight: 800; color: #FF8FAB; letter-spacing: 2rpx; }
.page-sub { font-size: 26rpx; color: #7A6E8A; font-weight: 500; }
.cook-hero-img { width: 100%; margin-top: 32rpx; border-radius: 32rpx; box-shadow: 0 16rpx 40rpx rgba(139,119,149,0.12); display: block; }
.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.ml-16 { margin-left: 16rpx; }
.glass-card { background: rgba(255,255,255,0.85); border-radius: 32rpx; padding: 32rpx; box-shadow: 0 12rpx 40rpx rgba(139,119,149,0.10); backdrop-filter: blur(12rpx); border: 1rpx solid rgba(255,255,255,0.8); position: relative; overflow: hidden; }
.card-title { color: #5D5168; }
.row-between { display: flex; justify-content: space-between; align-items: center; }
.cook-hero { text-align: center; padding: 24rpx 0 8rpx; }
.cook-hero-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.cook-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.dish-list { display: flex; flex-wrap: wrap; gap: 20rpx; }
.dish-item { background: #FFFFFF; border-radius: 28rpx; padding: 16rpx 24rpx; font-size: 28rpx; color: #5D5168; display: flex; align-items: center; border: 2rpx solid #F0E8EE; box-shadow: 0 6rpx 16rpx rgba(139,119,149,0.06); position: relative; }
.dish-item.selected { background: #FFE8EE; border-color: #FF8FAB; color: #8B3A62; font-weight: 600; }
.dish-thumb { width: 64rpx; height: 64rpx; border-radius: 16rpx; margin-right: 16rpx; background: #F5F0F2; flex-shrink: 0; }
.dish-thumb-placeholder { display: flex; align-items: center; justify-content: center; font-size: 32rpx; background: #FFF0F5; }
.dish-name { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.dish-del { margin-left: 16rpx; color: #FF8FAB; font-size: 32rpx; line-height: 1; width: 40rpx; height: 40rpx; text-align: center; }
.dish-check { position: absolute; top: -8rpx; right: -8rpx; width: 32rpx; height: 32rpx; line-height: 32rpx; text-align: center; background: #FF8FAB; color: #fff; border-radius: 50%; font-size: 20rpx; font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(139,119,149,0.2); }
.add-dish-box { background: #FFF8FA; border-radius: 28rpx; padding: 24rpx; border: 2rpx solid #FFE8EE; }
.add-dish-title { font-size: 28rpx; font-weight: 700; color: #8B3A62; }
.add-dish-input { width: 100%; height: 96rpx; line-height: 96rpx; background: #FFFFFF; border-radius: 20rpx; padding: 0 24rpx; font-size: 30rpx; color: #2B2438; border: 2rpx solid #F0E8EE; box-sizing: border-box; }
.add-dish-actions { display: flex; align-items: center; gap: 20rpx; }
.dish-img-section { flex-shrink: 0; }
.dish-img-pick { width: 120rpx; height: 120rpx; border-radius: 24rpx; background: #FFFFFF; border: 2rpx dashed #FF8FAB; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
.dish-img-pick.has-image { border-style: solid; border-color: #F0E8EE; }
.dish-img-preview { width: 120rpx; height: 120rpx; border-radius: 24rpx; }
.dish-img-plus { font-size: 48rpx; line-height: 1; }
.dish-img-tip { font-size: 22rpx; color: #FF8FAB; margin-top: 6rpx; }
.dish-img-remove { position: absolute; top: -12rpx; right: -12rpx; width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; background: rgba(139,58,98,0.9); color: #fff; border-radius: 50%; font-size: 28rpx; z-index: 2; }
.btn-add-dish { flex: 1; height: 96rpx; line-height: 96rpx; font-size: 30rpx; border-radius: 48rpx; }
.dish-note-list { display: flex; flex-direction: column; gap: 12rpx; }
.dish-note-item { display: flex; align-items: center; background: #FFFFFF; border-radius: 20rpx; padding: 0 20rpx; border: 2rpx solid #F0E8EE; }
.dish-note-name { font-size: 26rpx; color: #8B3A62; font-weight: 600; flex-shrink: 0; max-width: 180rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.dish-note-input { flex: 1; height: 80rpx; line-height: 80rpx; font-size: 26rpx; color: #2B2438; padding-left: 16rpx; min-width: 0; }
.order-dishes { font-size: 28rpx; color: #5D5168; font-weight: 500; line-height: 1.5; }
.order-dish-note { display: flex; flex-direction: column; gap: 8rpx; }
.order-dish-note-line { display: flex; align-items: center; font-size: 24rpx; line-height: 1.5; background: #FFF8FA; border-radius: 12rpx; padding: 10rpx 16rpx; }
.order-dish-note-name { color: #8B3A62; font-weight: 600; flex-shrink: 0; margin-right: 12rpx; }
.order-dish-note-text { color: #7A6E8A; flex: 1; }
.order-note { font-size: 24rpx; color: #9A8EAA; background: #F8F6FA; border-radius: 12rpx; padding: 10rpx 16rpx; }
.form-input { flex: 1; background: #FFFFFF; border-radius: 20rpx; padding: 0 24rpx; height: 88rpx; line-height: 88rpx; font-size: 28rpx; color: #2B2438; border: 2rpx solid #F0E8EE; box-shadow: 0 4rpx 12rpx rgba(139,119,149,0.04); min-width: 0; }
.form-input:focus { border-color: #FF8FAB; }
.order-box { background: #FFF8FA; border-radius: 28rpx; padding: 24rpx; border: 2rpx solid #FFE8EE; }
.order-box-title { font-size: 28rpx; font-weight: 700; color: #8B3A62; margin-bottom: 16rpx; }
.picker { background: #FFFFFF; border-radius: 20rpx; padding: 0 24rpx; height: 96rpx; line-height: 96rpx; border: 2rpx solid #F0E8EE; color: #5D5168; font-size: 28rpx; }
.btn-submit-order { width: 100%; height: 96rpx; line-height: 96rpx; font-size: 30rpx; border-radius: 48rpx; }
.order-list { padding-top: 8rpx; }
.order-item { background: #FFFFFF; border-radius: 24rpx; padding: 24rpx; margin-bottom: 20rpx; border: 2rpx solid #F5F0F2; }
.order-item:last-child { margin-bottom: 0; }
.order-status { font-size: 22rpx; padding: 6rpx 14rpx; border-radius: 14rpx; font-weight: 600; }
.status-pending { background: #FFF8E1; color: #8B5A00; }
.status-done { background: #E8F5E9; color: #33691E; }
.status-cancel { background: #ECEFF1; color: #546E7A; }
.order-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.announce-input { width: 100%; height: 160rpx; background: #FFFFFF; border-radius: 20rpx; padding: 18rpx 24rpx; font-size: 28rpx; color: #2B2438; border: 2rpx solid #F0E8EE; box-shadow: 0 4rpx 12rpx rgba(139,119,149,0.04); box-sizing: border-box; }
.announcement-item { padding: 16rpx 0; border-bottom: 1rpx solid #F5F0F2; }
.announcement-item:last-child { border-bottom: none; }
.announcement-text { color: #5D5168; font-size: 26rpx; line-height: 1.6; }
.empty-tip { padding: 32rpx 0; color: #9A8EAA; text-align: center; font-size: 26rpx; }
.safe-bottom { height: 40rpx; }
