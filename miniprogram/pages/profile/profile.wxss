/* ===== 新增：登录后完善资料卡片 profile-fixer-card 美化版 ===== */
.profile-fixer-card {
  margin-left: 24rpx;
  margin-right: 24rpx;
  border-radius: 36rpx;
  padding: 36rpx 32rpx 32rpx;
  background:
    radial-gradient(circle at 12% 0%, rgba(255, 183, 204, 0.38) 0%, rgba(255, 183, 204, 0) 55%),
    radial-gradient(circle at 100% 100%, rgba(184, 169, 255, 0.34) 0%, rgba(184, 169, 255, 0) 60%),
    linear-gradient(145deg, rgba(255, 250, 252, 0.92), rgba(246, 243, 255, 0.88));
  border: 2rpx solid rgba(255, 143, 171, 0.22);
  box-shadow:
    0 20rpx 60rpx rgba(255, 143, 171, 0.14),
    0 6rpx 20rpx rgba(184, 169, 255, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
  position: relative;
  overflow: hidden;
}
.fixer-card-deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(2rpx);
}
.fixer-deco-1 {
  width: 120rpx; height: 120rpx;
  top: -30rpx; right: -20rpx;
  background: radial-gradient(circle, rgba(255, 179, 198, 0.55), rgba(255, 179, 198, 0));
}
.fixer-deco-2 {
  width: 160rpx; height: 160rpx;
  bottom: -50rpx; left: -40rpx;
  background: radial-gradient(circle, rgba(184, 169, 255, 0.45), rgba(184, 169, 255, 0));
}
.fixer-deco-3 {
  width: 80rpx; height: 80rpx;
  top: 60%; right: 18%;
  background: radial-gradient(circle, rgba(255, 221, 153, 0.55), rgba(255, 221, 153, 0));
}
.fixer-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.fixer-title-wrap { flex: 1; min-width: 0; }
.fixer-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #D1477A;
  background: linear-gradient(135deg, rgba(255, 179, 198, 0.36), rgba(255, 228, 236, 0.6));
  border: 1rpx solid rgba(255, 143, 171, 0.25);
  letter-spacing: 0.5rpx;
}
.fixer-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #2B2438;
  line-height: 1.35;
  letter-spacing: 0.2rpx;
}
.fixer-desc {
  font-size: 22rpx;
  color: #8E7FA3;
  line-height: 1.55;
}
.fixer-collapse {
  flex-shrink: 0;
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(184, 169, 255, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(184, 169, 255, 0.16);
}
.fixer-arrow {
  width: 0; height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #B8A9FF;
  transform: translateY(2rpx);
  transition: transform .25s ease;
}
.fixer-arrow.up { transform: rotate(180deg) translateY(-2rpx); border-top-color: #FF8FAB; }

.fixer-body {
  position: relative;
  z-index: 2;
  margin-top: 28rpx;
}
.fixer-divider {
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(255, 143, 171, 0), rgba(255, 143, 171, 0.32), rgba(184, 169, 255, 0.36), rgba(255, 143, 171, 0));
  margin: 0 -8rpx;
}
.fixer-inner {
  margin-top: 28rpx;
  display: flex;
  align-items: stretch;
  gap: 24rpx;
}
.fixer-avatar-col {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.fixer-avatar-btn {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 48rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
  background: transparent;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fixer-avatar-btn::after { border: none; }
.fixer-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 48rpx;
  box-shadow:
    0 12rpx 32rpx rgba(255, 143, 171, 0.28),
    0 0 0 4rpx #FFFFFF,
    0 0 0 6rpx rgba(184, 169, 255, 0.35);
}
.fixer-avatar-placeholder {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 48rpx;
  background:
    radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 55%),
    linear-gradient(145deg, #FFE8EE, #EEE9FF);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow:
    0 12rpx 32rpx rgba(184, 169, 255, 0.22),
    0 0 0 4rpx #FFFFFF,
    0 0 0 6rpx rgba(255, 143, 171, 0.3);
}
.fixer-avatar-ring {
  position: absolute;
  inset: 6rpx;
  border-radius: 44rpx;
  border: 2rpx dashed rgba(255, 143, 171, 0.55);
  animation: fixer-spin 14s linear infinite;
}
@keyframes fixer-spin { to { transform: rotate(360deg); } }
.fixer-avatar-ph { font-size: 56rpx; filter: drop-shadow(0 4rpx 6rpx rgba(255, 143, 171, 0.25)); }
.fixer-avatar-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #07C160, #34D399);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 4rpx 10rpx rgba(7, 193, 96, 0.4),
    0 0 0 4rpx #FFFFFF;
  z-index: 3;
}
.fixer-avatar-label {
  font-size: 20rpx;
  color: #A094AC;
  text-align: center;
}

.fixer-nick-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.fixer-nick-label {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #6E5D8A;
  padding: 4rpx 0;
}
.fixer-nick-icon { font-size: 24rpx; }
.fixer-nick-wrap {
  position: relative;
  margin-top: 6rpx;
}
.fixer-nick-input {
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;
  padding: 0 32rpx 0 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #FFFFFF, #FFF9FB);
  border: 2rpx solid rgba(255, 143, 171, 0.28);
  box-shadow:
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.9),
    0 6rpx 18rpx rgba(255, 143, 171, 0.08);
  font-size: 28rpx;
  color: #2B2438;
  font-weight: 500;
}
.fixer-nick-input::placeholder { color: #C4B8D5; font-weight: 400; }
.fixer-nick-magic {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(255, 200, 80, 0.4));
  pointer-events: none;
}
.fixer-nick-hint {
  font-size: 20rpx;
  color: #B0A5C3;
}

.fixer-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.btn-fixer-cancel {
  height: 86rpx !important;
  line-height: 86rpx !important;
  border-radius: 999rpx !important;
  padding: 0 28rpx !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  color: #7A6B95 !important;
  background: linear-gradient(145deg, #FFFFFF, #F5F1FA) !important;
  border: 2rpx solid rgba(184, 169, 255, 0.32) !important;
  box-shadow: 0 6rpx 14rpx rgba(184, 169, 255, 0.1) !important;
}
.btn-fixer-save {
  height: 86rpx !important;
  line-height: 86rpx !important;
  border-radius: 999rpx !important;
  padding: 0 28rpx !important;
  font-size: 28rpx !important;
  font-weight: 700 !important;
  color: #FFFFFF !important;
  background: linear-gradient(135deg, #FF6B8E 0%, #FF8FAB 42%, #B8A9FF 100%) !important;
  box-shadow:
    0 14rpx 32rpx rgba(255, 107, 142, 0.3),
    0 4rpx 10rpx rgba(184, 169, 255, 0.2),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.35) !important;
  position: relative;
  overflow: hidden;
}
.btn-fixer-save[disabled] { opacity: 0.65; }
.btn-fixer-save::before {
  content: "";
  position: absolute;
  top: -50%;
  left: -40%;
  width: 40%;
  height: 200%;
  background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,0.42), rgba(255,255,255,0));
  transform: skewX(-20deg);
  animation: fixer-shine 3s ease-in-out infinite;
}
@keyframes fixer-shine {
  0%   { left: -40%; }
  60%  { left: 130%; }
  100% { left: 130%; }
}
