.login-wrap {
  padding: 64rpx 0 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.brand-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #FFB3C6, #B8A9FF);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
  box-shadow:
    0 20rpx 52rpx rgba(255, 143, 171, 0.28),
    inset 0 2rpx 10rpx rgba(255, 255, 255, 0.6);
  margin-top: 40rpx;
}
.brand-name {
  font-size: 56rpx;
  font-weight: 900;
  color: #FF8FAB;
  margin-top: 24rpx;
  letter-spacing: 2rpx;
}
.brand-slogan {
  font-size: 26rpx;
  color: #A094AC;
  margin-top: 12rpx;
}
.login-hero {
  width: 100%;
  padding: 40rpx 32rpx;
  margin-top: 56rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  background: linear-gradient(155deg, rgba(255, 143, 171, 0.10), rgba(184, 169, 255, 0.14));
  border-color: rgba(255, 143, 171, 0.25);
}
.hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  filter: blur(20rpx);
  pointer-events: none;
}
.deco-1 {
  top: -40rpx;
  right: -40rpx;
  width: 220rpx;
  height: 220rpx;
}
.deco-2 {
  bottom: -60rpx;
  left: -40rpx;
  width: 260rpx;
  height: 260rpx;
  opacity: 0.7;
}
.hero-inner {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hero-tag {
  margin-bottom: 16rpx;
}
.hero-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
  color: #2B2438;
  line-height: 1.4;
}
.hero-desc {
  font-size: 24rpx;
  color: #A094AC;
  line-height: 1.6;
}
.login-picker-card {
  width: 100%;
  padding: 32rpx 28rpx;
  margin-top: 48rpx;
}
.lp-header {
  font-size: 22rpx;
  color: #A094AC;
  margin-bottom: 16rpx;
}
.lp-row {
  display: flex;
  align-items: center;
}
.lp-avatar-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  padding: 0;
  background: linear-gradient(135deg, #FFE8EE, #EEE9FF);
  border: 2rpx dashed rgba(255, 143, 171, 0.5);
  flex-shrink: 0;
  overflow: hidden;
  margin: 0;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lp-avatar-btn-noborder {
  border: none;
}
.lp-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.lp-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.lp-avatar-placeholder > view + view {
  margin-top: 4rpx;
}
.lp-avatar-ph {
  font-size: 44rpx;
}
.lp-avatar-hint {
  font-size: 20rpx;
  color: #A094AC;
}
.lp-nick-wrap {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.lp-nick-input {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: #FFFBF8;
  border: 2rpx solid #F0E8EA;
  font-size: 28rpx;
  color: #2B2438;
}
.lp-note {
  font-size: 20rpx;
  color: #A094AC;
  margin-top: 16rpx;
  line-height: 1.5;
}
.btn-login {
  width: 100%;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wx-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}
.login-tip {
  font-size: 22rpx;
  color: #A094AC;
  margin-top: 24rpx;
  text-align: center;
  line-height: 1.6;
}
.link {
  color: #FF8FAB;
  font-weight: 700;
  text-decoration: underline;
  text-decoration-color: rgba(255, 143, 171, 0.6);
  text-underline-offset: 4rpx;
  margin: 0 2rpx;
}
.link-pink   { color: #FF6B8E; font-weight: 800; text-decoration: underline; text-decoration-color: rgba(255,107,142,.55); text-underline-offset: 4rpx; }
.link-purple { color: #7A6BD6; font-weight: 800; text-decoration: underline; text-decoration-color: rgba(122,107,214,.55); text-underline-offset: 4rpx; }

.mt-40 { margin-top: 40rpx; }
.mt-68 { margin-top: 136rpx; }

.protocol-card {
  width: 100%;
  padding: 24rpx 24rpx 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(255,255,255,0.94), rgba(246,243,255,0.85));
  border: 2rpx dashed rgba(255, 143, 171, 0.38);
  box-shadow:
    0 12rpx 30rpx rgba(255, 143, 171, 0.1),
    inset 0 2rpx 0 rgba(255,255,255,0.7);
  position: relative;
  box-sizing: border-box;
}
.protocol-title {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF8FAB, #B8A9FF);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  border: 2rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 142, 0.24);
}
.protocol-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 6rpx 4rpx 2rpx;
  line-height: 1.55;
}
.checkbox {
  flex-shrink: 0;
  margin-top: 2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(184, 169, 255, 0.55);
  box-shadow: 0 2rpx 6rpx rgba(122,107,214,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.22s ease;
}
.checkbox.checked {
  background: linear-gradient(135deg, #FF6B8E, #B8A9FF);
  border-color: #FF8FAB;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 142, 0.35);
}
.check-mark {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.1);
}
.protocol-text {
  flex: 1;
  font-size: 24rpx;
  color: #7A6B95;
  line-height: 1.65;
  word-break: break-all;
}
.protocol-hint {
  color: #B2A6C4;
  font-size: 20rpx;
  padding-left: 58rpx;
  line-height: 1.6;
}
.muted-light { color: #B2A6C4; }

.profile-top {
  margin-top: 48rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.msg-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 1rpx solid #F0E8EA;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 6rpx 16rpx rgba(184, 169, 255, 0.10);
}
.msg-emoji {
  font-size: 34rpx;
}
.msg-dot {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF6B6B;
  box-shadow: 0 0 6rpx rgba(255, 107, 107, 0.6);
}
.user-card {
  margin-top: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.user-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #FFE8EE, #EEE9FF);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #F0E8EA;
  position: relative;
  box-sizing: border-box;
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.avatar-fallback {
  font-size: 48rpx;
  font-weight: 800;
  color: #FF8FAB;
}
.avatar-edit-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB3C6, #B8A9FF);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  border: 2rpx solid #FFFFFF;
  z-index: 2;
}
.avatar-choose-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: transparent;
  padding: 0;
  margin: 0;
  border: none;
  z-index: 3;
}
.avatar-choose-btn::after {
  display: none;
}
.user-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #2B2438;
}
.user-status {
  margin-top: 6rpx;
}
.edit-btn {
  font-size: 22rpx;
  color: #A094AC;
  padding: 8rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.kpi-row {
  display: flex;
  margin-top: 24rpx;
}
.kpi-card {
  flex: 1;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-right: 16rpx;
}
.kpi-card:last-child {
  margin-right: 0;
}
.kpi-num {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.1;
}
.kpi-label {
  font-size: 20rpx;
  color: #A094AC;
  margin-top: 6rpx;
}
.menu {
  padding: 0 12rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  overflow: hidden;
  border: 1rpx solid #F0E8EA;
  box-shadow: 0 8rpx 24rpx rgba(184, 169, 255, 0.08);
}
.menu-item {
  padding: 28rpx 20rpx;
  display: flex;
  align-items: center;
}
.menu-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-body {
  flex: 1;
  min-width: 0;
}
.menu-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2438;
}
.menu-desc {
  font-size: 22rpx;
  color: #A094AC;
  margin-top: 4rpx;
  line-height: 1.4;
}
.menu-arrow {
  font-size: 28rpx;
  color: #A094AC;
  padding: 0 4rpx;
  flex-shrink: 0;
}
.menu-split {
  height: 1rpx;
  background: #F0E8EA;
  margin: 0 116rpx 0 116rpx;
}
.subscribe-test-row {
  padding: 16rpx 24rpx 24rpx;
  display: flex;
  justify-content: flex-end;
}
.subscribe-test-btn {
  font-size: 24rpx;
  color: #FF8FAB;
  border: 2rpx solid #FF8FAB;
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
  background: rgba(255, 143, 171, 0.08);
}
.mt-6 { margin-top: 6rpx; }
.mt-4 { margin-top: 4rpx; }
.mt-8 { margin-top: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }

/* ===== 新增：登录过期提示横幅 + 强制重新登录卡片 ===== */
