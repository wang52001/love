.head {
  margin-top: 40rpx;
}
.map-wrap {
  margin-top: 32rpx;
  padding: 0;
  min-height: 480rpx;
  position: relative;
  overflow: hidden;
}
.map-real {
  width: 100%;
  height: 480rpx;
  border-radius: 24rpx;
  display: block;
}
.map-empty {
  background: linear-gradient(135deg, #E8F4FB, #F3F0FF, #FFF5F2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-tip {
  font-size: 26rpx;
  color: #A094AC;
  background: rgba(255, 255, 255, 0.9);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}
.map-grad {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    radial-gradient(ellipse at 30% 30%, rgba(255, 255, 255, 0.7), transparent 60%),
    radial-gradient(ellipse at 70% 70%, rgba(255, 143, 171, 0.10), transparent 60%);
}
.map-road {
  position: absolute;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 20rpx;
}
.map-road.road-1 {
  top: 30%;
  left: -20%;
  width: 130%;
  height: 20rpx;
  transform: rotate(-6deg);
  opacity: 0.85;
}
.map-road.road-2 {
  top: 60%;
  left: -10%;
  width: 120%;
  height: 26rpx;
  transform: rotate(8deg);
  opacity: 0.75;
}
.map-road.road-3 {
  top: 15%;
  left: 30%;
  width: 20rpx;
  height: 100%;
  transform: rotate(4deg);
  opacity: 0.65;
}
.pin {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 5;
}
.pin-me {
  left: 18%;
  top: 42%;
}
.pin-ta {
  right: 14%;
  top: 32%;
}
.pin-emoji {
  font-size: 60rpx;
  line-height: 1;
  filter: drop-shadow(0 6rpx 14rpx rgba(0, 0, 0, 0.18));
}
.pin-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
  color: #5D5168;
}
.distance-line {
  position: absolute;
  top: 50%;
  left: 22%;
  right: 22%;
  height: 24rpx;
  display: flex;
  align-items: center;
  transform: rotate(-4deg);
  z-index: 3;
}
.line-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FF8FAB;
  box-shadow: 0 0 8rpx rgba(255, 143, 171, 0.6);
}
.line-dot.right {
  margin-left: auto;
}
.line-path {
  flex: 1;
  height: 0;
  border-top: 2rpx dashed rgba(255, 143, 171, 0.55);
}
.distance-tag {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -120%);
  z-index: 10;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #FF8FAB;
  font-weight: 800;
  font-size: 22rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 143, 171, 0.25);
  white-space: nowrap;
}
.info-cards {
  margin-top: 32rpx;
}
.info-card {
  padding: 24rpx;
  margin-top: 16rpx;
}
.info-card:first-child {
  margin-top: 0;
}
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.info-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.info-text-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.info-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  background: linear-gradient(135deg, #EEE9FF, #FFE8EE);
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.info-icon.me {
  background: linear-gradient(135deg, #E8F4FB, #EEE9FF);
}
.info-icon.ta {
  background: linear-gradient(135deg, #FFE8EE, #FFF3D6);
}
.info-label {
  font-size: 22rpx;
  color: #A094AC;
}
.info-address {
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.settings {
  margin-top: 40rpx;
}
.set-card {
  padding: 28rpx;
}
.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.set-title {
  font-size: 28rpx;
  font-weight: 600;
}
.set-desc {
  font-size: 22rpx;
  color: #A094AC;
  margin-top: 6rpx;
}
.switch {
  width: 96rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #E8E2EA;
  padding: 3rpx;
  position: relative;
  transition: all 0.2s;
  flex-shrink: 0;
}
.switch-thumb {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.14);
  transition: all 0.2s;
}
.switch.on {
  background: linear-gradient(135deg, #FF8FAB, #B8A9FF);
}
.switch.on .switch-thumb {
  transform: translateX(44rpx);
}
.split {
  height: 1rpx;
  background: #F0E8EA;
  margin-top: 24rpx;
}
.chevron {
  font-size: 28rpx;
  color: #A094AC;
}
.cta-wrap {
  margin-top: 48rpx;
  margin-bottom: 32rpx;
}
.loc-action {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.btn-locate {
  width: 100%;
  height: 96rpx !important;
  line-height: 96rpx !important;
  border-radius: 999rpx !important;
  font-size: 30rpx !important;
  font-weight: 700 !important;
  color: #FFFFFF !important;
  background: linear-gradient(135deg, #7393B3 0%, #A8C5E6 50%, #B8A9FF 100%) !important;
  box-shadow: 0 14rpx 36rpx rgba(115, 147, 179, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.35) !important;
  display: flex;
  align-items: center;
  justify-content: center;
}
.locate-emoji {
  margin-right: 12rpx;
  font-size: 34rpx;
}
.locate-tip {
  color: #A094AC;
}
.mt-24 { margin-top: 24rpx; }
.mt-4 { margin-top: 4rpx; }
.mt-6 { margin-top: 6rpx; }

.addr-input-row {
  display: flex;
  align-items: center;
}
.relocate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.addr-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: rgba(255, 143, 171, 0.06);
  border: 2rpx solid rgba(184, 169, 255, 0.3);
  border-radius: 20rpx;
  color: #4A3F55;
}
.addr-btn {
  margin-left: 16rpx;
  padding: 0 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FF8FAB, #B8A9FF);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.addr-btn.btn-disabled {
  opacity: 0.55;
}
